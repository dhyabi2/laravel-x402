parameters:
    level: 8

    # config/x402.php is plain data read through env(); Larastan's env rule
    # only recognises an application's own config directory, not a package's.
    paths:
        - src
        - database

    # A trait written for other people's test suites is never used inside the
    # package, so PHPStan cannot analyse it. Its logic lives in the analysed
    # PaymentBuilder; the trait is delegation only.
    excludePaths:
        - src/Testing/MakesX402Payments.php

    tmpDir: build/phpstan

    treatPhpDocTypesAsCertain: false
